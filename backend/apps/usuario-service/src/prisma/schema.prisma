generator client {
  provider = "prisma-client-js"
  output   = "../../../../node_modules/.prisma/usuario-client"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id        String     @id @default(uuid()) @db.Uuid
  admin     Boolean    @default(false)
  nome      String     @db.VarChar(150)
  email     String     @unique @db.VarChar(255)
  senha     String     @db.VarChar(255)
  enderecos Endereco[]

  @@map("usuarios")
}

model Endereco {
  id          String  @id @default(uuid()) @db.Uuid
  bairro      String  @db.VarChar(150)
  cep         String  @db.VarChar(9)
  cidade      String  @db.VarChar(150)
  complemento String? @db.VarChar(150)
  estado      String  @db.VarChar(2)
  numero      String  @db.VarChar(20)
  principal   Boolean @default(false)
  rua         String  @db.VarChar(255)
  user_id     String  @db.Uuid
  usuario     Usuario @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("enderecos")
}